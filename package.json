{
  "name": "ua-pii-redactor",
  "private": true,
  "description": "Client-side PII redactor for Ukrainian text. Detection runs in TypeScript (@ua-pii/core).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @ua-pii/web",
    "build": "npm run build -w @ua-pii/web",
    "preview": "npm run preview -w @ua-pii/web",
    "generate": "npm run generate -w @ua-pii/eval",
    "eval": "npm run eval -w @ua-pii/eval --",
    "check-baseline": "npm run check-baseline -w @ua-pii/eval"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
