{
  "name": "@ua-pii/eval",
  "version": "0.1.0",
  "description": "Synthetic dataset generator and evaluation CLI for @ua-pii/core.",
  "type": "module",
  "bin": {
    "ua-pii-eval": "./src/cli.ts"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
