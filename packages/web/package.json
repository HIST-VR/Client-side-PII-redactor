{
  "name": "@ua-pii/web",
  "version": "0.1.0",
  "private": true,
  "description": "In-browser demo for the Ukrainian PII redactor. Rules run on the UI thread; NER runs in a Web Worker.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ua-pii/core": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "happy-dom": "^17.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^2.1.0"
  }
}
